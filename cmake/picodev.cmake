# picodev - include AFTER project(): initialises the SDK, adds the libraries
# and defines picodev_add_app().
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(NOT PD_HOST)
    pico_sdk_init()
endif()

if(NOT TARGET pd_core)
    set(_pd ${PICODEV_ROOT}/lib)
    add_subdirectory(${_pd}/core       ${CMAKE_BINARY_DIR}/picodev/core)
    add_subdirectory(${_pd}/hal        ${CMAKE_BINARY_DIR}/picodev/hal)
    add_subdirectory(${_pd}/input      ${CMAKE_BINARY_DIR}/picodev/input)
    add_subdirectory(${_pd}/fs         ${CMAKE_BINARY_DIR}/picodev/fs)
    add_subdirectory(${_pd}/gfx        ${CMAKE_BINARY_DIR}/picodev/gfx)
    add_subdirectory(${_pd}/ui         ${CMAKE_BINARY_DIR}/picodev/ui)
    add_subdirectory(${_pd}/system     ${CMAKE_BINARY_DIR}/picodev/system)
    add_subdirectory(${_pd}/net        ${CMAKE_BINARY_DIR}/picodev/net)
    add_subdirectory(${_pd}/crosspoint ${CMAKE_BINARY_DIR}/picodev/crosspoint)
    add_subdirectory(${_pd}/text       ${CMAKE_BINARY_DIR}/picodev/text)
    add_subdirectory(${_pd}/epub       ${CMAKE_BINARY_DIR}/picodev/epub)
    if(NOT PD_HOST)
        add_subdirectory(${_pd}/drivers ${CMAKE_BINARY_DIR}/picodev/drivers)
    endif()
    add_subdirectory(${_pd}/terminals  ${CMAKE_BINARY_DIR}/picodev/terminals)
    if(NOT TARGET pd_terminal_${PD_TERMINAL})
        message(FATAL_ERROR "picodev: unknown terminal '${PD_TERMINAL}'")
    endif()
    add_library(pd_terminal INTERFACE)
    target_link_libraries(pd_terminal INTERFACE pd_terminal_${PD_TERMINAL})
    add_subdirectory(${_pd}/app        ${CMAKE_BINARY_DIR}/picodev/app)
    add_subdirectory(${_pd}/usb        ${CMAKE_BINARY_DIR}/picodev/usb)
    add_subdirectory(${_pd}/miniz      ${CMAKE_BINARY_DIR}/picodev/miniz)

    # Wi-Fi exists only on CYW43 boards (and in the host simulation).
    if(PD_HOST OR PICO_CYW43_SUPPORTED)
        set(PD_HAS_WIFI ON CACHE INTERNAL "")
    else()
        set(PD_HAS_WIFI OFF CACHE INTERNAL "")
    endif()
    add_subdirectory(${_pd}/tls        ${CMAKE_BINARY_DIR}/picodev/tls)
    add_subdirectory(${_pd}/git        ${CMAKE_BINARY_DIR}/picodev/git)
    add_subdirectory(${_pd}/bt         ${CMAKE_BINARY_DIR}/picodev/bt)
    if(PD_HOST)
        message(STATUS "picodev: host build (PC simulator + tests)")
    else()
        message(STATUS "picodev: terminal=${PD_TERMINAL} board=${PD_BOARD} wifi=${PD_HAS_WIFI}")
    endif()
endif()

# picodev_add_app(<name> SOURCES <files...> [LIBS <pd_libs...>]
#                 [TITLE "..."] [VERSION "1.0"] [USB_STDIO])
# Always links pd_app (terminal, ui, gfx, input, fs, core). On the device it
# produces <name>.uf2 (runs from BOOTSEL or the PicoCalc UF2 Loader).
function(picodev_add_app name)
    cmake_parse_arguments(A "USB_STDIO" "TITLE;VERSION" "SOURCES;LIBS" ${ARGN})
    add_executable(${name} ${A_SOURCES})
    target_link_libraries(${name} PRIVATE pd_app ${A_LIBS})
    target_compile_options(${name} PRIVATE -Wall -Wextra -Wno-unused-parameter
        $<$<COMPILE_LANGUAGE:CXX>:-Wno-psabi>)
    if(NOT A_VERSION)
        set(A_VERSION "0.1")
    endif()
    target_compile_definitions(${name} PRIVATE PD_APP_VERSION="${A_VERSION}")
    if(PD_HOST)
        target_compile_options(${name} PRIVATE -g)
    else()
        target_compile_options(${name} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions -fno-rtti>)
        if(NOT A_TITLE)
            set(A_TITLE ${name})
        endif()
        pico_set_program_name(${name} "${A_TITLE}")
        pico_set_program_version(${name} "${A_VERSION}")
        if(A_USB_STDIO)
            pico_enable_stdio_usb(${name} 1)
            pico_enable_stdio_uart(${name} 0)
        else()
            pico_enable_stdio_usb(${name} 0)
            pico_enable_stdio_uart(${name} 1)
        endif()
        pico_add_extra_outputs(${name})
    endif()
endfunction()
